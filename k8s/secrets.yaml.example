# Example secrets file - DO NOT commit actual secrets!
# Copy this file to secrets.yaml and fill in real values
# Then apply with: kubectl apply -f secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: adapt-secrets
  labels:
    app: adapt
type: Opaque
stringData:
  # Required
  secret-key: "your-secret-key-here"
  neo4j-uri: "neo4j://neo4j:7687"
  neo4j-user: "neo4j"
  neo4j-password: "your-neo4j-password"

  # Optional integrations
  slack-bot-token: "xoxb-your-slack-token"
  slack-webhook-url: "https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
  pagerduty-api-key: "your-pagerduty-api-key"
  anthropic-api-key: "sk-ant-your-anthropic-key"
  openai-api-key: "sk-your-openai-key"

  # Optional connectors
  prometheus-url: "http://prometheus:9090"
  datadog-api-key: "your-datadog-api-key"
  datadog-app-key: "your-datadog-app-key"
